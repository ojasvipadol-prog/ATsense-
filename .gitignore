# ============================================================
# ATSense AI — Git Ignore Rules
# ============================================================

# 🔑 Secrets & Environment Variables (NEVER commit these)
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# 🗄️ Database & Uploaded User Data
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/atsense.db
backend/atsense.db
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/exports/*
!backend/data/exports/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/exports/*
!data/exports/.gitkeep

# 🐍 Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# 📦 Node & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/node_modules/

# 💻 OS & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
